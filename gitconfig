[user]
	name = Jos Dehaes
	email = jos.dehaes@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = master
[core]
	excludesfile = ~/.gitignore
[pull]
	rebase = true
[diff]
    external = difft
[pager]
    difftool = true
[sendemail]
	smtpEncryption = tls
	smtpServer = smtp.gmail.com
	smtpUser = jos.dehaes@gmail.com
	smtpServerPort = 587
[credential]
	helper = libsecret
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[color]
	ui = auto
[merge]
	tool = mergers
[mergetool "mergers"]
	cmd = mergers \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
	trustExitCode = true
